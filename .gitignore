# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# 虚拟环境
.venv/
venv/
env/
ENV/

# ============================================================
# 测试与静态检查缓存
# ============================================================
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ============================================================
# 环境变量与密钥（绝不入库）
# ============================================================
.env
.env.local
.env.*.local
*.pem
*.key

# 真实配置文件（含数据库密码、密钥）。只提交 config.yaml.example
#
# 必须写 `**/`：Git 的忽略规则里，带斜杠的模式是**相对于 .gitignore 所在目录**的，
# 单个 `configs/config.yaml` 只匹配仓库根目录那一份，匹配不到 backend/configs/ 下的。
**/configs/config.yaml

# ============================================================
# Node / 前端（web/ 下另有一份更细的规则，这里兜底）
# ============================================================
node_modules/
.nuxt/
.output/
.nitro/
.cache/
dist/
*.tsbuildinfo

# ============================================================
# IDE
# ============================================================
.idea/
.vscode/
*.swp
*.swo

# 浏览器自动化的临时快照目录（playwright-cli 默认输出位置）
.playwright-cli/

# ============================================================
# 运行时产物
# ============================================================
logs/
*.log
tmp/
data/
*.sqlite3
