# 构建上下文排除项。
# 镜像越小越好：这里每多拷 100 MB，每次部署就多传 100 MB。

.git
.gitignore
.github

# 虚拟环境：本地的 .venv 有几百 MB，而且和镜像内的 Python 不兼容
.venv
venv

__pycache__
*.py[cod]
*.egg-info

# 测试与静态检查缓存
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov

# 测试代码与一次性脚本不进镜像（CI 在 runner 上单独跑）
tests
scripts

# 运行时产物
logs
*.log

# 真实配置（含数据库密码、SMTP 授权码）。镜像里只放 .example
configs/config.yaml

# 文档与本地工具数据
docs
.workbuddy
.idea
.vscode
